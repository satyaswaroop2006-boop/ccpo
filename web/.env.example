# Base URL of the compute/ FastAPI service (Part F §F.5 -- talks directly
# to app/main.py, no BFF layer). Server-only (no NEXT_PUBLIC_ prefix): read
# only inside Server Components/route handlers, never shipped to the client
# bundle -- see src/lib/api.ts.
API_BASE_URL=http://localhost:8000

# Supabase Auth (Part F §F.5/§F.6, Slice 5). Same Supabase project as
# compute/.env's DATABASE_URL/SUPABASE_URL -- this is the PUBLIC-safe
# anon/publishable key (Project Settings -> API), a DIFFERENT value from
# compute/.env's SUPABASE_SERVICE_ROLE_KEY, which must never appear here
# or reach a browser. NEXT_PUBLIC_ prefix is deliberate: the browser
# client (src/lib/supabase/client.ts) needs these for the magic-link
# sign-in form -- RLS (Part D Decision 9), not secrecy of this key, is
# what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=https://ptvsmjajvqwgrldznfza.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The single allow-listed admin account (Part F §F.6's decision: real
# auth, restricted to one account, no general sign-up). Server-only --
# lib/auth.ts::getAdminSession compares the signed-in session's email
# against this. Must match an email that already exists as a Supabase
# Auth user (created directly in the Supabase dashboard, never by this
# app -- signInWithOtp uses shouldCreateUser:false).
ADMIN_ALLOWED_EMAIL=
