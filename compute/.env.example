# Local dev:
DATABASE_URL=postgresql://localhost/ccpo_dev
# Supabase (service role — server side only, never in a browser):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ingest capture (Part I SS I.1) -- Supabase Storage, a separate service from
# the Postgres connection above. Dashboard -> Project Settings -> API.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role secret key -- never the anon key>

# Part F §F.6, Slice 6 (docs/DECISIONS.md #168): app/auth.py::
# get_admin_session verifies a caller's bearer token against Supabase's
# own Auth API (reusing SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above) and
# checks the resulting email against this allow-list -- same value as
# web/.env.local's ADMIN_ALLOWED_EMAIL, held separately because compute/
# and web/ are separately deployed services.
# ADMIN_ALLOWED_EMAIL=


