{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ccpo-api",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["app.main:app", "--reload", "--app-dir", "compute", "--port", "8000", "--env-file", "compute/.env"],
      "port": 8000
    },
    {
      "name": "ccpo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    }
  ]
}
